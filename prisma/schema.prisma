generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Category {
  electronics
  clothing
  food
  other
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  category    Category
  description String?
  imageUrl    String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

# SQLite database URI. For PostgreSQL, use a corresponding Prisma connection URI.
DATABASE_URL="file:./dev.db"

# Generate independent long random values, for example with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET="replace-with-a-long-random-access-secret"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-refresh-secret"

# Enable request logs only during local development.
DEBUG="false"

# Allowed browser origin. Set a specific origin in production.
CORS_ORIGIN="http://localhost:3000"
